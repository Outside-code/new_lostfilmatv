[Unit]
Description=LostFilm QR auth bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lostfilm
Group=lostfilm
WorkingDirectory=/opt/lostfilm-auth
EnvironmentFile=/etc/lostfilm-auth.env
ExecStart=/opt/lostfilm-auth/venv/bin/uvicorn auth_bridge.main:app --host 127.0.0.1 --port 18015 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
StateDirectory=lostfilm-auth
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=384M

[Install]
WantedBy=multi-user.target
